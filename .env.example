# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# LLM — global fallback (used by both agents when per-service keys are blank)
# Leave OPENAI_API_KEY empty to use the deterministic mock for both agents.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# DeepSeek key (used when *_LLM_PROVIDER=deepseek and the per-service key is blank)
DEEPSEEK_API_KEY=

# Per-service LLM overrides (leave blank to inherit the global values above)
# Supported providers: openai | deepseek | gemini
SCENARIO_LLM_PROVIDER=openai
SCENARIO_LLM_API_KEY=
SCENARIO_LLM_MODEL=

EVALUATOR_LLM_PROVIDER=openai
EVALUATOR_LLM_API_KEY=
EVALUATOR_LLM_MODEL=

# Number of free-text questions generated per assessment
NUM_QUESTIONS=1

# Bayesian Knowledge Tracing parameters (global constants for the MVP — a real
# system would fit per-concept slip/guess from data). Each must be in (0, 1),
# and BKT_P_SLIP + BKT_P_GUESS must be < 1 for the model to be identifiable.
BKT_P_TRANSIT=0.10    # chance an unknown skill becomes known between opportunities
BKT_P_SLIP=0.10       # chance of answering wrong despite knowing it
BKT_P_GUESS=0.20      # chance of answering right despite not knowing it
BKT_BASE_PRIOR=0.30   # prior mastery for a root concept before any evidence

# Beta-Bernoulli mastery model (per-concept Beta(alpha, beta) posterior backing
# each mastery belief; see docs/mastery-update.md). All hand-set for the MVP.
BETA_PRIOR_ALPHA=2.0        # pseudo-evidence "for" mastery before any answer (prior mean 0.5)
BETA_PRIOR_BETA=2.0         # pseudo-evidence "against" mastery before any answer
BETA_BASE_WEIGHT=1.0        # evidence mass contributed by one answer
BETA_HALF_LIFE_DAYS=30.0    # forgetting: accumulated evidence halves every this many days
BETA_MIN_EVIDENCE_MASS=3.0  # gate: effective observations needed before trusting mastery
BETA_MASTERY_THRESHOLD=0.7  # gate: posterior mean at/above this counts as mastered
BETA_CONFIDENCE_Z=1.2816    # z-score for the one-sided credible lower bound (~90%)

# Recommendation engine
RECOMMEND_MASTERY_THRESHOLD=0.7   # mastery at/above which a concept counts as "mastered"
ROADMAP_MAX_STEPS=10              # max concepts in the previewed learning roadmap
