# Copy to .env.local and adjust.

# When "true", the dashboard renders from in-memory mock data shaped to the real
# API schema — no backend or Postgres needed. Set "false" to hit the live API.
VITE_USE_MOCKS=true

# Live FastAPI base URL (used when VITE_USE_MOCKS=false).
VITE_API_BASE_URL=http://localhost:8000/api/v1

# The user whose competency map / recommendation the dashboard loads (live mode).
# Must be a real user UUID present in the backend DB.
VITE_USER_ID=00000000-0000-0000-0000-000000000001
